(one (Int));(tt (Bool));(inc (-> (Int) (Int)));(not (-> (Bool) (Bool)));(sing (-> a (L a)));(length (-> (L a) (Int)));(k (-> a (-> a (Int))));(eq (-> a (-> a (Bool))));(l1 (L (Int)));(nil (L a));(l4 (L (Bool)))

