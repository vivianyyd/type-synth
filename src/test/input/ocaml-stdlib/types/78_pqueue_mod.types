// IntMinQueue
// Pqueue is a functor, so the examples use one instance of MakeMin, defined for them in OCaml as
// module IntMinQueue = Pqueue.MakeMin (Int). Its elements are ints; a smaller int is popped first.
// type t
val create : unit -> t
val length : t -> int
val is_empty : t -> bool
val add : t -> int -> unit
val add_iter : t -> ((int -> unit) -> 'x -> unit) -> 'x -> unit
val min_elt : t -> int option
val get_min_elt : t -> int
val pop_min : t -> int option
val remove_min : t -> unit
val clear : t -> unit
val copy : t -> t
val of_array : int array -> t
val of_list : int list -> t
val of_iter : ((int -> unit) -> 'x -> unit) -> 'x -> t
val iter_unordered : (int -> unit) -> t -> unit
val fold_unordered : ('acc -> int -> 'acc) -> 'acc -> t -> 'acc
